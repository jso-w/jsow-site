---
import { SPRITE_IDS, asset } from '../../lib/footballmoney/config';

const base = import.meta.env.BASE_URL;
const sprites = SPRITE_IDS.map((id) => asset(base, `sprites/sprite_${id}.webp`));
---

<div class="fm-pitch" aria-hidden="true"></div>
<svg class="fm-field" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"></svg>
<div class="fm-sprites" aria-hidden="true"></div>
<div class="fm-pitch-overlay" aria-hidden="true"></div>

<slot />

<script is:inline define:vars={{ sprites }}>
  (function () {
    /* ---- fixed, viewport-sized horizontal pitch ---- */
    var STROKE = 'rgba(255,255,255,0.42)';
    function rect(x, y, w, h, lw) {
      return '<rect x="' + x + '" y="' + y + '" width="' + w + '" height="' + h +
        '" fill="none" stroke="' + STROKE + '" stroke-width="' + lw + '"/>';
    }
    function circ(cx, cy, r) {
      return '<circle cx="' + cx + '" cy="' + cy + '" r="' + r +
        '" fill="none" stroke="' + STROKE + '" stroke-width="2"/>';
    }
    function dot(cx, cy, r) {
      return '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="' + STROKE + '"/>';
    }
    function arc(d) {
      return '<path d="' + d + '" fill="none" stroke="' + STROKE + '" stroke-width="2"/>';
    }

    function drawField() {
      var svg = document.querySelector('.fm-field');
      if (!svg) return;
      var d = document.documentElement;
      var W = d.clientWidth, H = d.clientHeight;
      if (H < 200) return;
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
      svg.setAttribute('width', W);
      svg.setAttribute('height', H);
      var pad = Math.round(Math.min(W, H) * 0.05);
      var fx = pad, fy = pad, fw = W - 2 * pad, fh = H - 2 * pad;
      var mx = fx + fw / 2, my = fy + fh / 2;
      var paH = fh * 0.56, paW = fw * 0.155, paY = fy + (fh - paH) / 2;
      var gaH = fh * 0.26, gaW = fw * 0.055, gaY = fy + (fh - gaH) / 2;
      var cr = Math.max(56, Math.min(fh * 0.2, fw * 0.13));
      var spot = fw * 0.1, c = Math.max(14, fw / 80);
      svg.innerHTML =
        rect(fx, fy, fw, fh, 3) +
        '<line x1="' + mx + '" y1="' + fy + '" x2="' + mx + '" y2="' + (fy + fh) +
          '" stroke="' + STROKE + '" stroke-width="2"/>' +
        circ(mx, my, cr) + dot(mx, my, 5) +
        rect(fx, paY, paW, paH, 2) + rect(fx, gaY, gaW, gaH, 2) + dot(fx + spot, my, 4) +
        rect(fx + fw - paW, paY, paW, paH, 2) + rect(fx + fw - gaW, gaY, gaW, gaH, 2) +
        dot(fx + fw - spot, my, 4) +
        arc('M ' + (fx + c) + ' ' + fy + ' A ' + c + ' ' + c + ' 0 0 1 ' + fx + ' ' + (fy + c)) +
        arc('M ' + (fx + fw - c) + ' ' + fy + ' A ' + c + ' ' + c + ' 0 0 0 ' + (fx + fw) + ' ' + (fy + c)) +
        arc('M ' + fx + ' ' + (fy + fh - c) + ' A ' + c + ' ' + c + ' 0 0 1 ' + (fx + c) + ' ' + (fy + fh)) +
        arc('M ' + (fx + fw) + ' ' + (fy + fh - c) + ' A ' + c + ' ' + c + ' 0 0 0 ' + (fx + fw - c) + ' ' + (fy + fh));
    }

    /* ---- per-page sprite arrangements, as fractions of the viewport ----
       Goal-mouth slots come first (x about 0.05 / 0.95), then a sideline slot,
       then outfield players scattered uniquely per page, so no two pages look
       alike. Which sprite lands in which slot is decided at render time. */
    var PAGE_LAYOUTS = [
      [{x:0.06,y:0.46},{x:0.94,y:0.54},{x:0.50,y:0.05},{x:0.22,y:0.50},{x:0.30,y:0.22},
       {x:0.70,y:0.30},{x:0.86,y:0.72},{x:0.40,y:0.90},{x:0.62,y:0.84},{x:0.14,y:0.78}],
      [{x:0.05,y:0.55},{x:0.95,y:0.45},{x:0.50,y:0.94},{x:0.12,y:0.30},{x:0.28,y:0.62},
       {x:0.46,y:0.40},{x:0.64,y:0.66},{x:0.82,y:0.28},{x:0.90,y:0.60},{x:0.20,y:0.88}],
      [{x:0.07,y:0.50},{x:0.93,y:0.50},{x:0.04,y:0.10},{x:0.18,y:0.70},{x:0.34,y:0.32},
       {x:0.50,y:0.78},{x:0.66,y:0.24},{x:0.80,y:0.66},{x:0.92,y:0.16},{x:0.40,y:0.12}],
      [{x:0.06,y:0.40},{x:0.94,y:0.60},{x:0.96,y:0.08},{x:0.16,y:0.20},{x:0.24,y:0.84},
       {x:0.42,y:0.54},{x:0.58,y:0.28},{x:0.74,y:0.80},{x:0.88,y:0.44},{x:0.34,y:0.70}],
      [{x:0.05,y:0.52},{x:0.95,y:0.48},{x:0.06,y:0.90},{x:0.20,y:0.34},{x:0.36,y:0.68},
       {x:0.50,y:0.18},{x:0.62,y:0.56},{x:0.78,y:0.32},{x:0.86,y:0.82},{x:0.30,y:0.94}],
      [{x:0.07,y:0.44},{x:0.93,y:0.56},{x:0.92,y:0.92},{x:0.14,y:0.64},{x:0.26,y:0.26},
       {x:0.44,y:0.82},{x:0.56,y:0.40},{x:0.70,y:0.70},{x:0.84,y:0.22},{x:0.48,y:0.06}],
      [{x:0.06,y:0.50},{x:0.94,y:0.50},{x:0.50,y:0.04},{x:0.18,y:0.42},{x:0.18,y:0.74},
       {x:0.40,y:0.24},{x:0.40,y:0.86},{x:0.62,y:0.30},{x:0.62,y:0.78},{x:0.84,y:0.56}],
      [{x:0.05,y:0.58},{x:0.95,y:0.42},{x:0.50,y:0.95},{x:0.12,y:0.22},{x:0.30,y:0.50},
       {x:0.22,y:0.82},{x:0.48,y:0.32},{x:0.66,y:0.64},{x:0.80,y:0.20},{x:0.90,y:0.78}],
      [{x:0.07,y:0.48},{x:0.93,y:0.52},{x:0.04,y:0.16},{x:0.16,y:0.78},{x:0.32,y:0.36},
       {x:0.46,y:0.66},{x:0.58,y:0.22},{x:0.72,y:0.54},{x:0.86,y:0.30},{x:0.88,y:0.86}],
      [{x:0.06,y:0.54},{x:0.94,y:0.46},{x:0.96,y:0.90},{x:0.14,y:0.34},{x:0.26,y:0.72},
       {x:0.40,y:0.46},{x:0.54,y:0.74},{x:0.68,y:0.34},{x:0.82,y:0.62},{x:0.36,y:0.10}],
      [{x:0.06,y:0.48},{x:0.94,y:0.52},{x:0.50,y:0.06},{x:0.20,y:0.28},{x:0.30,y:0.70},
       {x:0.46,y:0.40},{x:0.60,y:0.82},{x:0.72,y:0.26},{x:0.84,y:0.66},{x:0.16,y:0.88}]
    ];

    var currentPageIndex = 0;

    function placeSprites() {
      var layer = document.querySelector('.fm-sprites');
      if (!layer || !sprites.length) return;
      var layout = PAGE_LAYOUTS[currentPageIndex] || PAGE_LAYOUTS[0];
      var d = document.documentElement, W = d.clientWidth, H = d.clientHeight;
      layer.innerHTML = '';

      /* Rotate the sprite set per page so adjacent pages never start on the
         same sprite. A step of 7 is coprime to typical set sizes, and
         consecutive slots always differ, so no two neighbours match. */
      var off = currentPageIndex * 7;

      layout.forEach(function (pos, i) {
        var src = sprites[(i + off) % sprites.length];
        if (!src) return;
        var sz = 44 + ((i + currentPageIndex) % 3) * 9; // 44 / 53 / 62
        var rot = (i % 2 ? 1 : -1) * (4 + ((i + currentPageIndex) % 9));
        var img = document.createElement('img');
        img.src = src;
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.setAttribute('aria-hidden', 'true');
        img.style.cssText =
          'position:absolute;left:' + Math.round(pos.x * W - sz / 2) + 'px;top:' +
          Math.round(pos.y * H - sz / 2) + 'px;width:' + sz + 'px;height:auto;opacity:0.78;' +
          'transform:rotate(' + rot + 'deg);image-rendering:pixelated;' +
          'image-rendering:crisp-edges;transition:opacity 0.4s;';
        layer.appendChild(img);
      });
    }

    /* ---- deck: delayed snap, reveal, dot and keyboard navigation ---- */
    if ('scrollRestoration' in history) {
      try { history.scrollRestoration = 'manual'; } catch (e) { /* ignore */ }
    }
    try { window.scrollTo(0, 0); } catch (e) { /* ignore */ }

    var root = document.documentElement, snapTimer = null;
    function enableSnap() { root.classList.add('snap-on'); }
    function suspendSnap(ms) {
      root.classList.remove('snap-on');
      clearTimeout(snapTimer);
      snapTimer = setTimeout(enableSnap, ms || 900);
    }
    function goTo(pg) { suspendSnap(900); pg.scrollIntoView({ behavior: 'smooth' }); }

    function initDeck() {
      if (document.querySelector('.deck-dots')) return;
      var pages = Array.prototype.slice.call(document.querySelectorAll('.page'));
      if (!pages.length) return;

      var nav = document.createElement('div');
      nav.className = 'deck-dots';
      nav.setAttribute('role', 'navigation');
      nav.setAttribute('aria-label', 'Dashboard sections');
      pages.forEach(function (pg, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', 'Page ' + (i + 1));
        b.addEventListener('click', function () { goTo(pg); });
        nav.appendChild(b);
      });
      document.body.appendChild(nav);

      var dots = nav.children, current = 0;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting && e.intersectionRatio >= 0.55) {
            e.target.classList.add('in-view');
            current = pages.indexOf(e.target);
            if (currentPageIndex !== current) {
              currentPageIndex = current;
              placeSprites();
            }
            for (var k = 0; k < dots.length; k++) {
              dots[k].classList.toggle('active', k === current);
            }
          }
        });
      }, { threshold: [0.55] });
      pages.forEach(function (p) { io.observe(p); });

      document.addEventListener('keydown', function (ev) {
        if (ev.key === 'ArrowDown' || ev.key === 'PageDown') {
          if (current < pages.length - 1) { ev.preventDefault(); goTo(pages[current + 1]); }
        } else if (ev.key === 'ArrowUp' || ev.key === 'PageUp') {
          if (current > 0) { ev.preventDefault(); goTo(pages[current - 1]); }
        }
      });
    }

    function boot() { drawField(); placeSprites(); initDeck(); }
    document.addEventListener('DOMContentLoaded', boot);
    window.addEventListener('load', function () { boot(); setTimeout(enableSnap, 1600); });
    setTimeout(boot, 600);
    setTimeout(enableSnap, 3500); /* fallback if 'load' is delayed */
    window.addEventListener('resize', function () {
      drawField(); placeSprites(); suspendSnap(700);
    });
  })();
</script>
